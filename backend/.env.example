# Backend environment (copy to .env for local dev).

# --- Database (Supabase Postgres, async driver) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Supabase auth (JWT verification) ---
SUPABASE_URL=http://localhost:54321
# For local dev the CLI prints a JWT secret; set it for HS256 verification.
# Leave blank in production to use asymmetric JWKS verification.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Service-role key (admin Auth generateLink). Optional locally — invites
# degrade to a copyable link when unset.
SUPABASE_SERVICE_ROLE_KEY=

# --- App / email (invitations + digests) ---
# Production: https://www.newswithfriends.org (deep links in emails).
APP_BASE_URL=http://localhost:3000
# Resend API key. Optional locally — invite/digest emails are skipped when unset.
RESEND_API_KEY=
EMAIL_FROM=NewsWithFriends <noreply@newswithfriends.org>

# --- Daily digest worker (nwf-digest) ---
DIGEST_ENABLED=true
DIGEST_SEND_HOUR_PT=4
DIGEST_LOOKBACK_DAYS=2
DIGEST_CONCURRENCY=5
DIGEST_MAX_LINES=6

# --- API ---
CORS_ORIGINS=["http://localhost:3000"]
API_HOST=0.0.0.0
API_PORT=8000
# Optional shared secret for admin/scrape endpoints.
ADMIN_API_SECRET=

# --- Scraper ---
# ScrapingBee proxy/JS-render fallback for blocked link previews (optional).
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_TIMEOUT_SECONDS=40
URL_FETCH_TIMEOUT_SECONDS=20

# --- Friend graph ---
# Friend slots per account (accepted friends + unanswered requests).
MAX_FRIENDS=150
# Unanswered email invitations one account may have outstanding at once.
MAX_PENDING_INVITES=25

# --- Moderation ---
# Where reported posts are emailed. Reports are logged only when unset.
MODERATION_REPORT_EMAIL=

# --- Discover ---
# Trailing windows tried in order when ranking the Discover tab; it widens
# until DISCOVER_MIN_ITEMS stories qualify.
DISCOVER_WINDOWS_HOURS=[24,72,168]
DISCOVER_MIN_ITEMS=10
DISCOVER_LIMIT=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
